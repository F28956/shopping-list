// Makes the header importable from Swift as a module, which is what lets the wrapper
// live in an ordinary source file instead of behind a per-target bridging header --
// there are two targets that want it and a bridging header is one per target.
module QuickAddC {
    header "quickadd.h"
    export *
}

// The device's own server. A separate module from QuickAddC because they are separate
// libraries with separate lifetimes -- see web/embedded.
module EmbeddedC {
    header "embedded.h"
    export *
}
