// Copy to Config.xcconfig and fill in. That copy is gitignored.
//
// None of these are secrets. An iOS OAuth client id is embedded in every copy of the
// app and is public by design — it identifies the app, it does not authorise it.
// Google's iOS clients have no client secret at all, which is why the flow uses PKCE.

// From the Google Cloud console: Credentials → OAuth client ID → iOS.
GOOGLE_IOS_CLIENT_ID =
// The same value with its parts reversed, which the console shows you. It is the URL
// scheme Google redirects back to, so sign-in cannot return without it.
GOOGLE_IOS_REVERSED_CLIENT_ID =

// Where the server is. `localhost` on a phone is the phone; the simulator shares the
// Mac's network, so localhost is right there and wrong on a handset.
SHOPPING_LIST_API_BASE_URL = http:/$()/localhost:8080
