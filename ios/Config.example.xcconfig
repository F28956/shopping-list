// Copy to Config.xcconfig and fill in. That copy is gitignored.
//
// Neither of these is a secret. A team identifier is stamped into every signed build
// and is visible in the app bundle; it identifies who signed the app, it does not
// authorise anything.

// The ten characters from developer.apple.com -> Membership. Sign in with Apple
// checks the entitlement against a provisioning profile, so a build with the wrong
// team here fails at the button rather than at the build.
DEVELOPMENT_TEAM = ABCDE12345

// Where the server is. `localhost` on a phone is the phone; the simulator shares the
// Mac's network, so localhost is right there and wrong on a handset.
SHOPPING_LIST_API_BASE_URL = http:/$()/localhost:8080
