<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext, anywhere.

  C6. Once the server address is something a person types, the app can be pointed
  anywhere — and the choice is between shipping a blanket permission for plain HTTP and
  refusing it. This refuses it. The alternative puts every user's shopping list and
  their bearer token on whatever cafe Wi-Fi they happen to be on, and is the kind of
  thing store review asks about.

  The debug build overrides this file wholesale (`app/src/debug/res/xml/`), because a
  server on the same desk is the case that would otherwise be impossible to develop
  against.

  The other half is `ServerAddress.allowsCleartext()`, which refuses the address before
  a connection is ever attempted — so somebody typing `http://` is told why, rather than
  meeting a failure from deep inside the networking stack.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
