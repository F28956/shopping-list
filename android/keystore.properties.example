# Copy to keystore.properties and fill in. That copy is gitignored, and so is the
# keystore file itself.
#
# Make the keystore once, and then never lose it:
#
#   keytool -genkeypair -v -keystore ~/keys/shopping-list.jks \
#       -alias shopping-list -keyalg RSA -keysize 4096 -validity 10000
#
# Twenty-seven years of validity, because a certificate that expires is an app that
# can no longer be updated. Keep a copy of the file and the passwords somewhere that
# is not this machine -- losing them means every person holding the app has to
# uninstall it, and uninstalling throws away any list their device has not sent to a
# server.
#
# Its SHA-1 has to be registered with Google against com.cernauskas.shoppinglist, or
# sign-in fails in exactly the builds you hand out and works in every build you test:
#
#   keytool -list -v -keystore ~/keys/shopping-list.jks -alias shopping-list

# Relative to the android/ directory, or absolute. Outside the repository is better.
storeFile=/Users/you/keys/shopping-list.jks
storePassword=
keyAlias=shopping-list
keyPassword=
