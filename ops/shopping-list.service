# The server, under systemd.
#
# Install:
#
#   sudo cp shopping-list.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shopping-list
#
# Where things live, and why they are apart:
#
#   /usr/local/bin/shopping-list-server   the binary, root-owned, not writable by it
#   /etc/shopping-list/server.env         the settings, root-owned 0600
#   /var/lib/shopping-list/               the database, owned by the service user
#
# The settings are read by systemd rather than by the application. `EnvironmentFile`
# is loaded **as root, before privileges are dropped**, so the file holding a Google
# client secret and a metrics token need not be readable by the account the server
# runs as -- which it would have to be if the server found its own `.env`.
#
# That is a real difference and not a stylistic one: `dotenvy::dotenv()` searches from
# the working directory, so a `.env` in /var/lib would be readable by anything running
# as `shopping-list`. Leave the settings in /etc and let systemd hand them over.
#
# **The syntax is not quite dotenv's.** systemd wants `KEY=value` with no `export`,
# and treats a `#` at the start of a line as a comment but not mid-line. Quote any
# value containing spaces.

[Unit]
Description=Shopping List
Documentation=https://github.com/
# `network-online` rather than `network`: an ACME order on the first boot needs a
# route to exist, and `network.target` is reached long before one does.
After=network-online.target
Wants=network-online.target

[Service]
# `exec` rather than `simple`, so `systemctl start` fails when the binary cannot be
# executed instead of reporting success and leaving a dead unit behind.
Type=exec

User=shopping-list
Group=shopping-list

ExecStart=/usr/local/bin/shopping-list-server
EnvironmentFile=/etc/shopping-list/server.env

# /var/lib/shopping-list, created and chowned on first start. Named rather than
# written out, so the sandboxing below does not have to make an exception for it.
StateDirectory=shopping-list
WorkingDirectory=/var/lib/shopping-list

Restart=on-failure
RestartSec=5s
# The server refuses to start on configuration it cannot make sense of -- a bad
# TLS_MODE, a METRICS_PORT that collides, an unreachable database. Without a limit
# that refusal becomes a restart loop that fills the journal and hides the one line
# saying what is wrong. Five tries and it stays down.
StartLimitBurst=5
StartLimitIntervalSec=120

# --- What it may do -------------------------------------------------------------
#
# A shopping list needs a socket, a directory and nothing else. Everything below is
# closing a door it never uses.

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No JIT anywhere in this process, so nothing needs a page that is both writable and
# executable.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Everything it creates -- the database, the WAL, an ACME cache -- is private to the
# service user. The application asks for 0700 on the certificate directory itself;
# this makes that the default rather than the exception.
UMask=0077

# Uncomment only if this process holds its own certificate *and* serves on 443.
# Behind a reverse proxy it must stay commented: the capability would be granted for
# a port the server never binds.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
