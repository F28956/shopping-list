# Copy to `web/.env` and fill in. Nothing reads this file — `dotenvy` loads `.env`.

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# A RELATIVE path, and nothing resolves it against this file's location — it is
# resolved against the current working directory, by two different things at two
# different times:
#
#   * the sqlx query macros, at compile time, with cargo's CWD at the workspace root
#     (`web/`), so this lands on `web/data.db`
#   * the binary, at run time, against whatever directory you launched it from
#
# `main.rs` sets `create_if_missing(true)`, so launching from the wrong directory does
# not fail — it silently creates an empty database there and migrates it. Run cargo
# from `web/`, or set an absolute path here.
DATABASE_URL="sqlite:///Users/yourusername/shopping-list-v2/web/data.db"
