# Copy to `web/.env` and fill in. Nothing reads this file — `dotenvy` loads `.env`.

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The iOS app's own client id, if the phone app is set up. One identity provider
# issues a different client id per platform, so the phone's tokens carry a different
# audience from the browser's and the API has to accept both. See ios/README.md.
# GOOGLE_IOS_CLIENT_ID="000000000000-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com"

# Use an ABSOLUTE path, and mind the three slashes: `sqlite://` + `/Users/...`.
#
# A relative path such as `sqlite:data.db` is resolved against the current working
# directory, and two different things resolve it at two different moments — the sqlx
# query macros at compile time, with cargo's CWD at the workspace root (`web/`), and
# the binary at run time, against whatever directory you launched it from. Those agree
# only as long as you always run cargo from `web/`. An absolute path removes the
# question.
#
# It is machine-specific, which is fine: `.env` is gitignored and this example is what
# gets committed.
#
# First-time setup, from `web/api`:
#     sqlx database create && sqlx migrate run
#
# The binary does not create the database if it is missing — a wrong path fails to
# start rather than silently serving an empty database.
DATABASE_URL="sqlite:///absolute/path/to/repo/web/data.db"

# The origin this application is served from. State-changing requests that say they
# came from anywhere else are refused — see web/src/csrf.rs.
PUBLIC_ORIGIN="http://localhost:8080"

# The session cookie is marked Secure unless this says otherwise, so the safe answer
# is the one you get by not thinking about it. A local run over http:// needs the
# exception; anything reachable from outside must not have it.
SESSION_INSECURE="true"

# Who may sign in. Comma-separated, or "*" to admit anyone.
# Required: without it the server refuses to start, because a default of
# "anyone" would make forgetting to set it look exactly like meaning it.
ALLOWED_EMAILS="you@example.com"

# Android normally needs nothing here. Credential Manager is given the web client id
# above as its serverClientId, and the token comes back addressed to that. The Android
# OAuth client -- registered against the package name and the signing certificate's
# SHA-1 -- is what lets Google attest the app; it does not name the audience.
#
# Set this only if a token does turn up addressed to the Android client.
# GOOGLE_ANDROID_CLIENT_ID="000000000000-zzzzzzzz.apps.googleusercontent.com"
