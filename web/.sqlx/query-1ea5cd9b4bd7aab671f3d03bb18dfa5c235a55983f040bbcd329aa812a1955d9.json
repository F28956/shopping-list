  "query": "\n            SELECT\n                t.id          as \"id: Id\",\n                t.name        as \"name: Name\",\n                t.colour      as \"colour?: Colour\",\n                t.emoji       as \"emoji?: Emoji\",\n                t.created_at  as \"created_at: CreatedAt\"\n            FROM tags t\n            JOIN item_tags it ON it.tag_id = t.id\n            WHERE it.item_id = ?1\n            ORDER BY t.name COLLATE NOCASE, t.id\n            ",
