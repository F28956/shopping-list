  "query": "\n            UPDATE items SET done_at = CASE WHEN ?1 THEN unixepoch() ELSE NULL END\n            WHERE id = ?2\n            RETURNING\n                id          as \"id!: Id\",\n                uuid        as \"uuid!: Uuid\",\n                list_id     as \"list_id: list::Id\",\n                name        as \"name: Name\",\n                amount      as \"amount: Amount\",\n                unit_id     as \"unit_id?: unit::Id\",\n                done_at     as \"done_at?: DoneAt\",\n                created_at  as \"created_at: CreatedAt\"\n            ",
