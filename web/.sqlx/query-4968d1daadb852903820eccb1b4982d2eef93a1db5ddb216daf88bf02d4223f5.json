  "query": "\n            INSERT INTO users (sub, email, name)\n            VALUES (?1, ?2, ?3)\n            ON CONFLICT(sub) DO UPDATE SET\n                email = coalesce(?2, users.email),\n                name  = coalesce(?3, users.name)\n            RETURNING\n                id          as \"id!: Id\",\n                sub         as \"sub: Sub\",\n                email       as \"email?: Email\",\n                name        as \"name?: Name\",\n                created_at  as \"created_at!: CreatedAt\"\n            ",
