  "query": "\n            SELECT\n                id          as \"id!: Id\",\n                list_id     as \"list_id: list::Id\",\n                name        as \"name: Name\",\n                amount      as \"amount: Amount\",\n                unit_id     as \"unit_id?: unit::Id\",\n                done_at     as \"done_at?: DoneAt\",\n                created_at  as \"created_at!: CreatedAt\"\n            FROM items\n            WHERE list_id = ?1\n            ORDER BY done_at IS NOT NULL, created_at\n            ",
