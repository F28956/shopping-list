  "query": "\n            SELECT\n                u.id          as \"id!: Id\",\n                u.sub         as \"sub: Sub\",\n                u.email       as \"email?: Email\",\n                u.name        as \"name?: Name\",\n                u.created_at  as \"created_at!: CreatedAt\"\n            FROM user_identities i\n            JOIN users u ON u.id = i.user_id\n            WHERE i.provider = ?1 AND i.subject = ?2\n            ",
